# AI Article Generator Configuration
# Copy this file to .env and fill in your values

# Anthropic API Key (required)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here

# Anthropic Model (optional)
# Options: claude-sonnet-4-20250514, claude-opus-4-20250514, claude-haiku-3-20250514
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google OAuth2 Credentials File (required for Google Docs)
# Download from Google Cloud Console
GOOGLE_CREDENTIALS_FILE=credentials.json

# Google Token File (auto-generated after first auth)
GOOGLE_TOKEN_FILE=token.json

# Google Drive Folder ID (optional)
# If set, articles will be saved to this specific folder
# Find the ID in the folder URL: drive.google.com/drive/folders/[FOLDER_ID]
GOOGLE_DRIVE_FOLDER_ID=

# Article Settings
ARTICLE_MIN_WORDS=800
ARTICLE_MAX_WORDS=2000
MAX_RESEARCH_SOURCES=5
